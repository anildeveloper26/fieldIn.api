PORT=4000
# Hosted Postgres with PostGIS (e.g. Aiven). Download the service CA cert and point sslrootcert at it.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require&sslrootcert=/absolute/path/to/ca.pem
REDIS_URL=redis://localhost:6379
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
FRONTEND_ORIGIN=http://localhost:3000
# Cloudflare R2 / S3-compatible storage for avatars and venue photos (optional)
R2_ACCOUNT_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_KEY_PREFIX=fieldin
# Optional public bucket URL; when unset, files are served through short-lived presigned URLs
R2_PUBLIC_BASE_URL=
# PEM of the database CA (Aiven: service Overview > CA certificate). Required for hosts with a private CA; TLS is verified against it.
DATABASE_CA_CERT=
